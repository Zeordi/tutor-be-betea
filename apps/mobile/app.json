{
  "expo": {
    "name": "Tutor Be Betea",
    "slug": "tutor-be-betea",
    "version": "4.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "tutorbebetea",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tutorbebetea.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.tutorbebetea.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ]
  }
}