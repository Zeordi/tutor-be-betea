# =============================================================================
# Tutor Be Betea — environment template
# Copy to .env (local / Codespace only). NEVER commit real secrets.
# Generate secrets: openssl rand -hex 32
# =============================================================================

# ---------------------
# SUPABASE / POSTGRESQL
# ---------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ---------------------
# UPSTASH REDIS (OTP / cache)
# ---------------------
UPSTASH_REDIS_REST_URL=https://YOUR_INSTANCE.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# ---------------------
# AUTH & SECURITY
# ---------------------
# At least 32 characters (prefer 64 hex)
JWT_SECRET=replace_with_long_random_string_min_32_chars

# AES vault (openssl rand -hex 32 → 64 hex chars)
ENCRYPTION_KEY=replace_with_64_hex_chars
VAULT_MASTER_KEY=replace_with_64_hex_chars

# HMAC audit chain secret
AUDIT_CHAIN_SECRET=replace_with_long_random_hex

# ---------------------
# SMS — AfroMessage (primary for Ethiopia)
# ---------------------
AFROMESSAGE_TOKEN=your_afromessage_token
AFROMESSAGE_IDENTIFIER_ID=your_afromessage_identifier_id
AFROMESSAGE_SENDER_NAME=your_sender_name

# ---------------------
# PAYMENTS
# ---------------------
TELEBIRR_API_KEY=
TELEBIRR_API_SECRET=
TELEBIRR_MERCHANT_ID=
TELEBIRR_BASE_URL=
TELEBIRR_NOTIFY_URL=

CBE_BIRR_API_KEY=
CBE_BIRR_MERCHANT_ID=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------------------
# VIDEO (LiveKit / Daily / Agora — fill when used)
# ---------------------
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-livekit-server

# ---------------------
# PUBLIC APP URLS (production Vercel)
# ---------------------
NODE_ENV=production

NEXT_PUBLIC_APP_URL=https://tutor-be-betea-web.vercel.app
NEXT_PUBLIC_ADMIN_URL=https://tutor-be-betea-admin.vercel.app
NEXT_PUBLIC_API_URL=https://tutor-be-betea-api.vercel.app
NEXT_PUBLIC_MOBILE_SCHEME=tutorbebetea://

# Mobile (use your machine/Codespace public URL in device testing)
EXPO_PUBLIC_API_URL=http://localhost:4000

# ---------------------
# SENTRY (optional)
# ---------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=